{
  "name": "nexus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:hero-lab": "vite --open /hero-lab.html",
    "build": "tsc -b && vite build",
    "check:hero-lab-excluded": "node scripts/assert-hero-lab-excluded.mjs",
    "update:live-data": "node scripts/update-live-data.mjs",
    "build:city-data": "node scripts/build-city-catalog.mjs",
    "build:phone-preview": "NEXUS_SINGLE_FILE=1 vite build --outDir dist-preview && node scripts/inline-preview.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "dexie": "^4.2.0",
    "h3-js": "^4.3.0",
    "lucide-react": "^0.539.0",
    "maplibre-gl": "^6.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-globe.gl": "^2.37.1",
    "satellite.js": "^6.0.2",
    "three": "^0.179.1",
    "zod": "^4.0.17",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fflate": "^0.8.3",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  }
}
